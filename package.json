{
  "name": "@kjerneverk/riotplan-e2e",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run typecheck",
    "test": "npm run test:core",
    "test:core": "vitest run --coverage --project local-http",
    "test:full": "vitest run --coverage --project local-http --project protocol",
    "test:http": "vitest run --project local-http",
    "test:stdio": "vitest run --project stdio",
    "test:protocol": "vitest run --project protocol",
    "test:ai": "vitest run --project ai",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "precommit": "npm run typecheck && npm run test:full",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kjerneverk/riotplan": "^1.0.26-dev.20260319013720.8564449"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "latest",
    "vitest": "latest"
  },
  "publishConfig": {
    "tag": "dev"
  }
}
